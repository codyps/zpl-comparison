--- /dev/null
+++ b/hosts/warbler/garm-bazel-disk.nix
@@ -0,0 +1,35 @@
+# Opt-in profile: attaching this cache lets every job using the profile modify
+# artifacts consumed by subsequent jobs. Use only within one job trust domain.
+{ ... }:
+{
+  # /var/lib is already persistent on Warbler. This is a separate Bazel disk
+  # cache, not bazel-remote's incompatible on-disk store.
+  systemd.tmpfiles.rules = [
+    "d /var/lib/garm-bazel-disk 0755 root root -"
+    # The Ubuntu cloud image's runner account has UID/GID 1000.
+    "d /var/lib/garm-bazel-disk/zpl-comparison 0700 1000 1000 -"
+  ];
+
+  virtualisation.incus.preseed.profiles = [{
+    name = "runner-zpl-comparison";
+    project = "garm";
+    config = { "limits.cpu" = "4"; "limits.memory" = "8GiB"; };
+    devices = {
+      root = { type = "disk"; path = "/"; pool = "garm"; size = "40GiB"; };
+      bazel-cache = {
+        type = "disk";
+        source = "/var/lib/garm-bazel-disk/zpl-comparison";
+        path = "/var/cache/bazel-persistent";
+      };
+      eth0 = {
+        type = "nic";
+        name = "eth0";
+        network = "garm0";
+        "security.mac_filtering" = "true";
+        "security.ipv4_filtering" = "true";
+        "security.ipv6_filtering" = "true";
+        "security.port_isolation" = "true";
+      };
+    };
+  }];
+}
