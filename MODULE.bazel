module(name = "zpl_comparison")

bazel_dep(name = "rules_python", version = "2.4.2")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "rules_nodejs", version = "6.7.6")
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "26.11.1")
use_repo(node, "nodejs_toolchains")
register_toolchains("@nodejs_toolchains//:all")
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
bazel_dep(name = "rules_go", version = "0.64.2", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "package_metadata", version = "0.0.13")
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.2")
go_deps = use_extension("//:build/go_deps.bzl", "go_deps")
use_repo(go_deps, "go_github_com_stirlingmarketinggroup_go_zpl", "gonative_github_com_stirlingmarketinggroup_go_zpl", "zebrash_github_com_ingridhq_zebrash")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.74.0")
register_toolchains("//:wasm_bindgen_toolchain")
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2021", versions = ["1.99.0"], extra_target_triples = ["wasm32-unknown-unknown"], opt_level = {"fastbuild": "3", "opt": "3", "dbg": "0"}, strip_level = {"fastbuild": "symbols", "opt": "symbols", "dbg": "none"})
use_repo(rust, "rust_toolchains")
rust_host = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
rust_host.host_tools(name = "comparison_rust_host", version = "1.99.0")
use_repo(rust_host, "comparison_rust_host")
register_toolchains("@rust_toolchains//:all")
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "rust_crates",
    host_tools = "@comparison_rust_host//:BUILD.bazel",
    cargo_lockfile = "//:build/rust/Cargo.lock",
    manifests = ["//:build/rust/Cargo.toml"],
    supported_platform_triples = ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "x86_64-apple-darwin", "aarch64-apple-darwin", "wasm32-unknown-unknown"],
)
crate.annotation(crate = "zpl-rs", gen_build_script = "off")
use_repo(crate, "rust_crates")
bazel_dep(name = "rules_dotnet", version = "0.22.2")
single_version_override(
    module_name = "rules_dotnet",
    version = "0.22.2",
    patches = ["//:build/patches/rules_dotnet-hermetic-publish.patch"],
    patch_strip = 1,
)
bazel_dep(name = "platforms", version = "1.1.0")

nuget = use_extension("//:build/dotnet_deps.bzl", "nuget")
use_repo(nuget, "comparison_nuget")
register_toolchains("@native_tools//:dotnet_registered")

# Use Python's native namespace packages instead of synthesizing __init__.py.
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
PYTHON_VERSION = "3.14.8"
# This patch release is newer than rules_python's bundled runtime manifest.
python.single_version_override(
    python_version = PYTHON_VERSION,
    urls = ["https://github.com/astral-sh/python-build-standalone/releases/download/20261009/cpython-{python_version}%2B20261009-{platform}-install_only_stripped.tar.gz"],
    sha256 = {
        "aarch64-apple-darwin": "936217c0e6893f51af939474bee18ecf5e6fe47b986d2c163f19b57c682e4a83",
        "aarch64-unknown-linux-gnu": "54f9cd13b97add6bbd077175b6d89f974cc582ece1c40ace1893067582edaf0e",
        "x86_64-apple-darwin": "0fe0c68a7f90458abd13b50a3d8f5f0cb5b2f0a1f33b6ef1445751cf2dc8b36e",
        "x86_64-unknown-linux-gnu": "ddc902fd26460f728758c67d80417c1031edf97589f1f162c4ba3aa158a35998",
    },
)
python.toolchain(python_version = PYTHON_VERSION)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "report_deps",
    python_version = PYTHON_VERSION,
    requirements_lock = "//:build/requirements.lock.txt",
)
use_repo(pip, "report_deps")

# Repository rules fetch dependencies; compilation is performed by cached actions.
native_tools = use_repo_rule("//:build/repositories.bzl", "native_tools")

native_tools(
    name = "native_tools",
    lock = "//:build/toolchains.lock.json",
)

native_inputs = use_repo_rule("//:build/repositories.bzl", "native_inputs")

native_inputs(
    name = "rust_inputs",
    kind = "rust",
    manifests = [
        "//:benchmarks/sources.lock.json",
        "//:benchmarks/adapters/rust/Cargo.toml",
        "//:benchmarks/adapters/rust/Cargo.lock",
    ],
)

native_inputs(
    name = "go_inputs",
    kind = "go",
    manifests = ["//:benchmarks/sources.lock.json"],
)

native_inputs(
    name = "node_inputs",
    kind = "node",
    manifests = ["//:benchmarks/sources.lock.json"],
)

native_inputs(
    name = "dotnet_inputs",
    kind = "dotnet",
    manifests = ["//:benchmarks/sources.lock.json"],
)

native_inputs(
    name = "zebrash_inputs",
    kind = "zebrash",
    manifests = ["//:benchmarks/sources.lock.json"],
)

native_inputs(
    name = "zpl_renderer_js_inputs",
    kind = "zpl-renderer-js",
    manifests = ["//:benchmarks/sources.lock.json"],
)

native_inputs(
    name = "zebrash_ts_inputs",
    kind = "zebrash-ts",
    manifests = ["//:benchmarks/sources.lock.json"],
)

native_inputs(
    name = "codyps_zpl_node_inputs",
    kind = "codyps-zpl-node",
    manifests = ["//:benchmarks/sources.lock.json"],
)

catalog = use_repo_rule("//:build/repositories.bzl", "catalog")

catalog(
    name = "report_catalog",
    python_version = PYTHON_VERSION,
    inputs = [
        "//:benchmarks/accuracy/pixels.py",
        "//:build/requirements.lock.txt",
        "//:build/native.bzl",
        "//:BUILD.bazel",
        "//:build/executable.bzl",
        "//:build/rust/Cargo.toml",
        "//:build/go_deps.bzl",
        "//:build/go-repositories.WORKSPACE",
        "//:build/rust/Cargo.lock",
        "//:build/dotnet_runtime.py",
        "//:build/dotnet_deps.bzl",
        "//:build/dotnet_toolchain.BUILD",
        "//:build/patches/rules_dotnet-hermetic-publish.patch",
        "//:MODULE.bazel",
        "//:build/probe.py",
        "//:benchmarks/invalid.py",
        "//:benchmarks/sources.lock.json",
        "//:build/render.py",
        "//:build/native_build.py",
        "//:build/bootstrap.py",
        "//:build/toolchains.lock.json",
        "//:benchmarks/adapters/dotnet/Comparison.csproj",
        "//:benchmarks/adapters/dotnet/Program.cs",
        "//:benchmarks/adapters/dotnet/fonts/DejaVu Fonts.LICENSE",
        "//:benchmarks/adapters/dotnet/fonts/DejaVu Sans Mono.ttf",
        "//:benchmarks/adapters/dotnet/fonts/README.md",
        "//:benchmarks/adapters/dotnet/fonts/TeX Gyre Fonts.LICENSE",
        "//:benchmarks/adapters/dotnet/fonts/TeX Gyre Heros Cn-Bold.otf",
        "//:benchmarks/adapters/dotnet/packages.lock.json",
        "//:benchmarks/adapters/dotnet/nuget-integrity.json",
        "//:benchmarks/adapters/go/go.mod",
        "//:benchmarks/adapters/go/go.sum",
        "//:benchmarks/adapters/go/main.go",
        "//:benchmarks/adapters/codyps-zpl-go/main.go",
        "//:benchmarks/adapters/codyps-zpl-go/go.mod",
        "//:benchmarks/adapters/labelary.py",
        "//benchmarks/adapters/node:main.mjs",
        "//benchmarks/adapters/node:renderers.mjs",
        "//:benchmarks/adapters/zebrash/go.mod",
        "//:benchmarks/adapters/zebrash/go.sum",
        "//:benchmarks/adapters/zebrash/main.go",
        "//benchmarks/adapters/zpl-renderer-js:package.json",
        "//benchmarks/adapters/zpl-renderer-js:package-lock.json",
        "//benchmarks/adapters/zpl-renderer-js:pnpm-lock.yaml",
        "//benchmarks/adapters/zpl-renderer-js:pnpm-workspace.yaml",
        "//benchmarks/adapters/zebrash-ts:package.json",
        "//benchmarks/adapters/zebrash-ts:package-lock.json",
        "//benchmarks/adapters/zebrash-ts:pnpm-lock.yaml",
        "//benchmarks/adapters/zebrash-ts:pnpm-workspace.yaml",
        "//benchmarks/adapters/zebrash-ts:api.mjs",
        "//benchmarks/adapters/node:package-lock.json",
        "//benchmarks/adapters/node:pnpm-lock.yaml",
        "//benchmarks/adapters/node:pnpm-workspace.yaml",
        "//benchmarks/adapters/node:package.json",
        "//:benchmarks/adapters/python.py",
        "//:benchmarks/adapters/rust/Cargo.lock",
        "//:benchmarks/adapters/rust/Cargo.toml",
        "//:benchmarks/adapters/rust/src/main.rs",
        "//:benchmarks/adapters/rust/src/probe.rs",
    ],
    manifests = [
        "//:references/font-controlled/catalog.json",
        "//:references/zq610-candidates/manifest.json",
        "//:benchmarks/accuracy/reference/manifest.json",
        "//:references/barcodes-zd621-v1/manifest.json",
        "//:docs/benchmarks/labelary/captures.json",
        "//:test-data/render-conformance/manifest.json",
        "//:test-data/external-zpl/manifest.json",
        "//:test-data/layout-accuracy/manifest.json",
        "//:test-data/invalid-zpl/manifest.json",
        "//:test-data/public-zpl/manifest.json",
        "//:references/public-zd621-20261002/manifest.json",
        "//:references/zq610-plus-v1/manifest.json",
        "//:references/paired-labelary/captures.json",
        "//:benchmarks/sources.lock.json",
        "//:benchmarks/accuracy/conformance-reference/manifest.json",
        "//:benchmarks/accuracy/external-reference/manifest.json",
        "//:benchmarks/accuracy/layout-reference/manifest.json",
    ],
)

observation_baseline = use_repo_rule("//:build/repositories.bzl", "observation_baseline")
observation_baseline(name = "observation_baseline", lock = "//:build/baseline.lock.json")

support_sources = use_repo_rule("//:build/repositories.bzl", "support_sources")
support_sources(name = "support_sources", lock = "//:benchmarks/sources.lock.json")

npm.npm_translate_lock(
    name = "npm_zplr",
    pnpm_lock = "//benchmarks/adapters/node:pnpm-lock.yaml",
    npm_package_lock = "//benchmarks/adapters/node:package-lock.json",
    data = ["//benchmarks/adapters/node:package.json", "//benchmarks/adapters/node:pnpm-workspace.yaml"],
    lifecycle_hooks = {"*": []},
    update_pnpm_lock = True,
)
use_repo(npm, "npm_zplr")

npm.npm_translate_lock(
    name = "npm_zpl_renderer_js",
    pnpm_lock = "//benchmarks/adapters/zpl-renderer-js:pnpm-lock.yaml",
    npm_package_lock = "//benchmarks/adapters/zpl-renderer-js:package-lock.json",
    data = ["//benchmarks/adapters/zpl-renderer-js:package.json", "//benchmarks/adapters/zpl-renderer-js:pnpm-workspace.yaml"],
    lifecycle_hooks = {"*": []},
    update_pnpm_lock = True,
)
use_repo(npm, "npm_zpl_renderer_js")

npm.npm_translate_lock(
    name = "npm_zebrash_ts",
    pnpm_lock = "//benchmarks/adapters/zebrash-ts:pnpm-lock.yaml",
    npm_package_lock = "//benchmarks/adapters/zebrash-ts:package-lock.json",
    data = ["//benchmarks/adapters/zebrash-ts:package.json", "//benchmarks/adapters/zebrash-ts:pnpm-workspace.yaml"],
    lifecycle_hooks = {"*": []},
    update_pnpm_lock = True,
)
use_repo(npm, "npm_zebrash_ts")

