http_file(name = "skia_darwin_arm64", url = "https://github.com/samizdatco/skia-canvas/releases/download/v3.0.8/darwin-arm64.gz", sha256 = "df5f6aec9b92a83861473dff8cf1ed3aea16b89af6f66a9cfbc25ff7fc7460a9", downloaded_file_path = "skia.node.gz")

