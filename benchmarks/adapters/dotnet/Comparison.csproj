<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="fonts/*" TargetPath="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="BinaryKits.Zpl.Viewer" Version="[1.3.1]" />
    <!-- ImageSharp >=3.2 requires a release-build license key; retain the upstream dependency. -->
    <!-- Keep managed graphics bindings and native assets on matching versions. -->
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="[4.153.1]" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="[4.153.1]" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="[14.2.1.301]" />
  </ItemGroup>
</Project>
