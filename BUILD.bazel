py_test(
    name = "canvas_profile_test",
    size = "small",
    srcs = [
        "build/canvas_profile_test.py",
        "build/render.py",
        "benchmarks/accuracy/pixels.py",
    ],
    main = "build/canvas_profile_test.py",
