[rust_binary(
    name = "rust_" + lib.replace("-", "_"),
    srcs = glob(["benchmarks/adapters/rust/src/**"]),
    crate_root = "benchmarks/adapters/rust/src/main.rs",
    crate_features = [lib],
    edition = "2021",
    rustc_flags = ["-Copt-level=3", "-Cstrip=symbols"],
    aliases = {dep: lib.replace("-", "_")},
    deps = [dep],
    tags = ["manual"],
) for lib, dep in [
    ("codyps-zpl", ":zpl"),
    ("labelize", "@rust_crates//:labelize"),
    ("forge", "@rust_crates//:zpl-forge"),
]]
[native_library(
    name = "library_" + lib,
    srcs = [],
    library = lib,
    binary = ":rust_" + lib.replace("-", "_"),
    deps = ["@rust_inputs//:" + lib],
) for lib in ["codyps-zpl", "labelize", "forge"]]
# The default wasm2go backend uses only the Go standard library. Compile the
# upstream shipped translation/data without regenerating or selecting native FFI.
go_library(
    name = "codyps_zpl_go_translated",
    srcs = ["@rust_inputs//:benchmarks/_work/zpl/zpl-go/internal/translated/module.go"],
    embedsrcs = ["@rust_inputs//:benchmarks/_work/zpl/zpl-go/internal/translated/module.dat"],
    importpath = "github.com/codyps/zpl/zpl-go/internal/translated",
)
go_library(
    name = "codyps_zpl_go",
    srcs = ["@rust_inputs//:zpl_go_srcs"],
    importpath = "github.com/codyps/zpl/zpl-go",
    deps = [":codyps_zpl_go_translated"],
)
go_binary(
    name = "codyps_zpl_go_adapter",
    srcs = ["benchmarks/adapters/codyps-zpl-go/main.go"],
    deps = [":codyps_zpl_go"],
    pure = "on",
    gc_linkopts = ["-s", "-w"],
    tags = ["manual"],
)
native_library(
    name = "library_codyps-zpl-go",
    library = "codyps-zpl-go",
    binary = ":codyps_zpl_go_adapter",
    deps = ["@rust_inputs//:codyps-zpl"],
)

go_binary(
    name = "go_adapter",
    srcs = ["benchmarks/adapters/go/main.go"],
    deps = ["@go_github_com_stirlingmarketinggroup_go_zpl//:go_default_library", "@go_github_com_stirlingmarketinggroup_go_zpl//render:go_default_library"],
    gc_linkopts = ["-s", "-w"],
    tags = ["manual"],
)
go_binary(
    name = "go_shared",
    embed = ["@gonative_github_com_stirlingmarketinggroup_go_zpl//cmd/libzpl:go_default_library"],
    linkmode = "c-shared",
    clinkopts = select({"@platforms//os:macos": ["-Wl,-install_name,@rpath/libzpl.dylib"], "//conditions:default": ["-Wl,-soname,libzpl.so"]}),
    out = select({"@platforms//os:macos": "libzpl.dylib", "//conditions:default": "libzpl.so"}),
    tags = ["manual"],
)
cc_import(
    name = "zpl_shared",
    shared_library = ":go_shared",
)
rust_binary(
    name = "rust_ffi",
    srcs = glob(["benchmarks/adapters/rust/src/**"]),
    crate_root = "benchmarks/adapters/rust/src/main.rs",
    crate_features = ["ffi"],
    edition = "2021",
    aliases = {"@rust_crates//:zpl-rs": "ffi"},
    deps = ["@rust_crates//:zpl-rs"],
    link_deps = [":zpl_shared"],
    rustc_flags = select({"@platforms//os:macos": ["-Clink-arg=-Wl,-rpath,@executable_path"], "//conditions:default": ["-Clink-arg=-Wl,-rpath,$$ORIGIN"]}),
