cc_binary(name = "memory_runner", srcs = ["build/memory_runner.c"])
cc_binary(name = "memory_fixture", srcs = ["build/memory_fixture.c"], testonly = True)

# bazel run executes the measurement process every time; only compilation is cached.
py_binary(
    name = "performance",
    srcs = ["build/performance.py", "benchmarks/run.py"],
    main = "build/performance.py",
    data = [":render_libraries", ":memory_runner"],
    deps = [requirement("pillow")],
)

py_test(
    name = "performance_test",
    size = "small",
    srcs = ["build/performance_test.py", "build/performance.py", "build/native_build.py", "benchmarks/run.py"],
    main = "build/performance_test.py",
    data = [":memory_runner", ":memory_fixture"],
    deps = [requirement("pillow")],
)

py_test(
    name = "automation_test",
    size = "small",
    srcs = ["build/automation_test.py", "build/baseline.py", "build/probe.py", "build/observation_inputs.py", "benchmarks/invalid.py", "benchmarks/accuracy/pixels.py", "benchmarks/formatting.py"],
    main = "build/automation_test.py",
    imports = ["benchmarks"],
    deps = [requirement("numpy"), requirement("pillow")],
)

filegroup(name = "support_results", srcs = [":reports"], output_group = "suite_support")

py_test(
    name = "support_test",
    size = "small",
    srcs = ["build/support_test.py"],
    main = "build/support_test.py",
    data = [":support_results", "benchmarks/sources.lock.json"],
)

pipeline(
    name = "reports_fonts",
    font_bundle = ":comparison_fonts",
    support_inputs = ["@rust_inputs//:support", "@go_inputs//:support", "@node_inputs//:support", "@dotnet_inputs//:support", "@support_sources//:files"],
    srcs = [":report_sources"],
    libraries = [":library_" + lib for lib in [
        "codyps-zpl",
        "labelize",
        "forge",
        "go",
        "ffi",
        "binarykits",
        "zplr",
        "zebrash",
        "zpl-renderer-js",
        "zebrash-ts",
    ]],
)

py_binary(
    name = "font_builder",
    srcs = ["benchmarks/fonts/build.py"],
    main = "benchmarks/fonts/build.py",
    data = glob(["benchmarks/fonts/source/**", "benchmarks/fonts/recovered/**"]) + ["benchmarks/fonts/sources.json"],
    deps = [requirement("fonttools")],
)

comparison_fonts(name = "comparison_fonts")

py_test(
    name = "font_profile_test",
    size = "medium",
    srcs = ["build/font_profile_test.py", "build/font_profile.py", "build/render.py", "benchmarks/fonts/build.py", "benchmarks/accuracy/pixels.py"],
    main = "build/font_profile_test.py",
    data = [":comparison_fonts", ":library_forge", ":library_binarykits", ":library_zplr", ":library_zebrash", ":library_zebrash-ts", ":library_zpl-renderer-js", "benchmarks/fonts/sources.json"] + glob(["benchmarks/fonts/source/**", "benchmarks/fonts/recovered/**"]),
    deps = [requirement("numpy"), requirement("pillow"), requirement("fonttools")],
)

py_test(
    name = "font_capture_test",
    srcs = ["build/font_capture_test.py", "build/compare.py", "build/font_profile.py", "benchmarks/fonts/capture.py", "benchmarks/accuracy/capture.py", "benchmarks/accuracy/cases.py", "benchmarks/accuracy/metrics.py", "benchmarks/accuracy/pixels.py"],
    main = "build/font_capture_test.py",
    data = [":comparison_fonts"] + glob(["references/**", "benchmarks/accuracy/*reference/**"], exclude = ["**/__pycache__/**"]),
