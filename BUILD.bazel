load("//:build/fonts.bzl", "comparison_fonts")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@report_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//:build/native.bzl", "native_library")
load("//:build/pipeline.bzl", "pipeline")

py_test(
    name = "report_runner_test",
    size = "small",
    srcs = [
        "build/stage.py",
        "build/report_runner_test.py",
    ],
    main = "build/report_runner_test.py",
    deps = [requirement("pillow")],
)

# Collected evidence and maintained sources only. Generated reports, differences,
# thumbnails, and the fixture coverage catalog are deliberately excluded.
# Fixture manifests/cases define the graph; renderer observations are outputs.
filegroup(
    name = "report_sources",
    srcs = glob(
        [
            "benchmarks/*.py",
            "benchmarks/*.json",
            "benchmarks/*.txt",
            "benchmarks/*.md",
            "benchmarks/templates/**",
            "benchmarks/adapters/**",
            "benchmarks/fonts/**",
            "benchmarks/accuracy/*.py",
            "benchmarks/accuracy/*.md",
            "benchmarks/accuracy/*reference/**",
            "references/**",
            "test-data/external-zpl/**",
            "test-data/public-zpl/**",
            "test-data/render-conformance/**",
            "test-data/layout-accuracy/**",
            "test-data/invalid-zpl/**",
            "docs/benchmarks/labelary/images/*.png",
            "docs/benchmarks/labelary/captures.json",
            "docs/public-examples/FINDINGS.md",
        ],
        exclude = [
            "benchmarks/popularity.json",
            "**/__pycache__/**",
            "**/target/**",
            "**/node_modules/**",
            "**/obj/**",
            "**/bin/**",
            "references/zq610-plus-v1/work/**",
            "docs/benchmarks/*/images/*-diff.png",
            "benchmarks/test_*.py",
            "test-data/*/COVERAGE.md",
            "references/zq610-candidates/saved/**",
            "references/zq610-plus-v1/analysis.json",
            "references/zq610-plus-v1/*/*-local.png",
        ],
    ) + [
        "LICENSE",
        "PROVENANCE.md",
        "README.md",
        "benchmarks/invalid/README.md",
        "build/validate.py",
        "build/invalid_report.py",
        "build/public_report.py",
        "build/paired_report.py",
        "docs/total-failure-audit.md",
        "docs/canvas-dimension-audit.md",
        "docs/README.md",
        "docs/benchmarks/argument-support.md",
        "docs/compatibility/METHODOLOGY.md",
        "docs/zpl-command-index.tsv",
        "docs/zpl-zbi2-pg-en.pdf",
    ],
)

py_binary(
    name = "native_builder",
    srcs = ["build/native_build.py"],
    main = "build/native_build.py",
)

[native_library(
    name = "library_" + lib,
    srcs = glob(["benchmarks/adapters/rust/src/**"]),
    library = lib,
    native = ":library_go-native" if lib == "ffi" else None,
    toolchain = ["@native_tools//:rust"],
    deps = ["@rust_inputs//:" + lib],
) for lib in [
    "codyps-zpl",
    "labelize",
    "forge",
    "ffi",
]]

[native_library(
    name = "library_" + lib,
    srcs = glob(["benchmarks/adapters/go/*.go"]) if lib == "go" else [],
    library = lib,
    toolchain = ["@native_tools//:go"],
    deps = ["@go_inputs//:files"],
) for lib in [
    "go",
    "go-native",
]]

native_library(
    name = "library_zplr",
    srcs = ["benchmarks/adapters/node/main.mjs"],
    library = "zplr",
    toolchain = ["@native_tools//:node"],
    deps = ["@node_inputs//:files"],
)

native_library(
    name = "library_zebrash",
    srcs = ["benchmarks/adapters/zebrash/main.go"],
    library = "zebrash",
    toolchain = ["@native_tools//:go"],
    deps = ["@zebrash_inputs//:files"],
)

[native_library(
    name = "library_" + lib,
    srcs = ["benchmarks/adapters/node/renderers.mjs"] + (["benchmarks/adapters/zebrash-ts/api.mjs"] if lib == "zebrash-ts" else []),
    library = lib,
    toolchain = ["@native_tools//:node"],
    deps = ["@" + lib.replace("-", "_") + "_inputs//:files"],
) for lib in ["zpl-renderer-js", "zebrash-ts"]]

native_library(
    name = "library_binarykits",
    srcs = glob([
        "benchmarks/adapters/dotnet/*.cs",
        "benchmarks/adapters/dotnet/*.csproj",
        "benchmarks/adapters/dotnet/*.json",
        "benchmarks/adapters/dotnet/fonts/**",
    ]),
    library = "binarykits",
    toolchain = ["@native_tools//:dotnet"],
    deps = ["@dotnet_inputs//:files"],
)

filegroup(
    name = "libraries",
    srcs = [":library_" + lib for lib in [
        "codyps-zpl",
        "labelize",
        "forge",
        "ffi",
        "go",
        "zplr",
        "zebrash",
        "zpl-renderer-js",
        "zebrash-ts",
        "binarykits",
    ]],
)

pipeline(
    name = "reports_saved",
    srcs = [":report_sources"],
    saved = True,
    baseline = ["@observation_baseline//:files"],
)

[py_binary(
    name = "action_" + name,
    srcs = ["build/" + name + ".py"] + extra + (["build/worker.py"] if name != "stage" else []),
    main = "build/worker.py" if name != "stage" else "build/stage.py",
    imports = ["benchmarks"],
    deps = [
        requirement("numpy"),
        requirement("pillow"),
    ] + ([requirement("matplotlib"), requirement("zxing-cpp")] if name == "stage" else []),
) for name, extra in [
    (
        "render",
        ["benchmarks/accuracy/pixels.py", "build/font_profile.py"],
    ),
    (
        "compare",
        [
            "benchmarks/accuracy/pixels.py",
            "benchmarks/accuracy/metrics.py",
        ],
    ),
    (
        "preview",
        ["benchmarks/accuracy/presentation.py"],
    ),
    (
        "pages",
        [
            "benchmarks/accuracy/presentation.py",
            "benchmarks/accuracy/overview.py",
            "benchmarks/formatting.py",
        ],
    ),
    (
        "aggregate",
        ["benchmarks/accuracy/pixels.py"],
    ),
    (
        "relation",
        ["benchmarks/accuracy/pixels.py"],
    ),
    ("saved", ["build/render.py", "benchmarks/accuracy/pixels.py"]),
    ("probe", ["benchmarks/invalid.py", "benchmarks/accuracy/pixels.py", "benchmarks/formatting.py"]),
    ("stage", []),
]]

filegroup(
    name = "render_libraries",
    srcs = [":library_" + lib for lib in [
        "codyps-zpl", "labelize", "forge", "go", "ffi", "binarykits", "zplr", "zebrash", "zpl-renderer-js", "zebrash-ts",
    ]],
)

pipeline(
    name = "reports",
    support_inputs = ["@rust_inputs//:support", "@go_inputs//:support", "@node_inputs//:support", "@dotnet_inputs//:support", "@support_sources//:files"],
    srcs = [":report_sources"],
    libraries = [":library_" + lib for lib in [
        "codyps-zpl",
        "labelize",
        "forge",
        "go",
        "ffi",
        "binarykits",
        "zplr",
        "zebrash",
        "zpl-renderer-js",
        "zebrash-ts",
    ]],
)

