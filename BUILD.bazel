)

rust_library(
    name = "raster_diff",
    srcs = ["@rust_inputs//:raster-diff_srcs"],
    crate_root = "@rust_inputs//:benchmarks/_work/zpl/raster-diff/src/lib.rs",
    edition = "2021",
)
rust_library(
    name = "zpl_bitmap_fonts",
    srcs = ["@rust_inputs//:zpl-bitmap-fonts_srcs"],
    crate_root = "@rust_inputs//:benchmarks/_work/zpl/zpl-bitmap-fonts/src/lib.rs",
    crate_features = ["zd621"],
    edition = "2021",
)
rust_library(
    name = "zpl",
    srcs = ["@rust_inputs//:zpl_srcs"],
    crate_root = "@rust_inputs//:benchmarks/_work/zpl/zpl/src/lib.rs",
    deps = [":raster_diff", ":zpl_bitmap_fonts", "@rust_crates//:encoding_rs", "@rust_crates//:unicode-normalization", "@rust_crates//:unicode-bidi"],
