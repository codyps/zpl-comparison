py_test(
    name = "adapter_contract_test",
    size = "small",
    srcs = [
        "build/adapter_contract_test.py",
        "build/render.py",
        "benchmarks/accuracy/pixels.py",
    ],
    main = "build/adapter_contract_test.py",
